@page
@model MarketLens.Pages.IndexModel
@using System.Globalization
@{ ViewData["Title"] = "Research"; }
<div class="workspace">
    <div class="intro"><div><p class="eyebrow">YOUR MARKET WORKSPACE</p><h1>Evidence before action.</h1><p class="muted">Timeframe-specific signals with transparent rules and data checks.</p></div>@if (Model.CanManage) { <a class="outline" asp-page="/Data">Manage data ↗</a> }</div>
    @if (Model.Notice is not null) { <aside class="notice">@Model.Notice</aside> }
    @if (Model.Error is not null) { <aside class="notice">@Model.Error</aside> }
    <div class="dashboard">
        <section class="panel explorer">
            <div class="panel-heading"><h2>Your favourites</h2><span class="count" id="favourite-count">0 saved</span></div><div id="favourites-list" class="stock-list"></div><p id="favourites-status" class="list-note" role="status">Favourites are saved in this browser. No login required.</p><noscript><p class="empty">Enable JavaScript to use browser favourites.</p></noscript>
            <div class="market-browser">
                <div class="browser-heading"><h2>Stock list</h2><span class="count">@Model.TotalCompanyCount total listings</span></div>
                <p class="muted">Browse stocks below. US, MY, SG and HK codes identify the market. Prices are checked when you open a stock.</p>
                <p class="list-note">Catalogue checked: @IndexModel.DisplayTime(Model.CatalogueCheckedAt). @if (Model.CatalogueRefreshFailed) { <span>Refresh unavailable; showing the last valid list.</span> } else if (Model.CatalogueCheckedAt is null) { <span>Showing the bundled list while checking for updates.</span> }</p>
                @if (!string.IsNullOrWhiteSpace(Model.Query)) { <p class="list-note">@Model.MatchingCount matching listings</p> }
                @if (!Model.SourceConfigured)
                {
                    <p class="connection-note">Daily prices are unavailable until the website owner connects the data provider. @if (Model.CanManage) { <a class="text-link" asp-page="/Data">Set up connection →</a> }</p>
                }
                <form method="get" asp-page-handler="Search" class="search-form">
                    <label class="sr-only" for="query">Filter the stock list (optional)</label><input id="query" name="Query" value="@Model.Query" placeholder="Filter this list (optional)" maxlength="80" />
                    <button type="submit">Filter</button>
                    @if (!string.IsNullOrWhiteSpace(Model.Query)) { <a class="text-link clear-search" asp-page="/Index">Clear</a> }
                </form>
            </div>
            @foreach (var company in Model.Companies)
            {
                <div class="market-result"><a class="stock-row search-result-button company-view" asp-page="/Index" asp-route-Symbol="@company.Symbol" asp-route-Query="@Model.Query" asp-route-BrowseOffset="@Model.BrowseOffset" asp-route-Horizon="@Model.Horizon"><span class="stock-name"><strong>@company.Name</strong><small>@company.Symbol · @company.Exchange</small><small class="availability">@Model.ListingStatus(company.Symbol)</small></span><span>View →</span></a><button type="button" class="outline favourite-toggle" data-symbol="@company.Symbol" data-name="@company.Name" aria-pressed="false" hidden>☆ Favourite</button></div>
            }
            @if (Model.Companies.Length == 0)
            { <p class="empty">No saved listings match this search. Clear the search to see the catalogue.</p> }
            @if (Model.BrowseOffset > 0 || Model.HasNext)
            {
                <nav class="browse-pages" aria-label="Company pages">
                    @if (Model.BrowseOffset > 0) { <a class="text-link" asp-page-handler="Browse" asp-route-Query="@Model.Query" asp-route-BrowseOffset="@(Math.Max(0, Model.BrowseOffset - 24))">← Previous</a> }
                    @if (Model.HasNext) { <a class="text-link" asp-page-handler="Browse" asp-route-Query="@Model.Query" asp-route-BrowseOffset="@(Model.BrowseOffset + 24)">Next companies →</a> }
                </nav>
            }
            <div class="setup-panel"><h2>Daily market data</h2><p class="muted">Browse the available companies and save favourites in this browser. Prices are daily closing data; their retrieval times are shown with each analysis.</p><a class="text-link" asp-page="/Index" asp-route-Demo="true">Explore a fictional demonstration</a></div>
        </section>
        <div class="detail-column">
        @if (Model.ShowIntradayQuote)
        {
            <section class="panel setup-panel" data-intraday-quote data-quote-url="@Url.Page("/Index", "Quote", new { Symbol = Model.Symbol })">
                <p class="eyebrow">INTRADAY PRICE SNAPSHOT</p><h2>@Model.Symbol</h2>
                <p class="quote"><strong data-quote-price>—</strong></p>
                <p class="list-note" data-quote-status role="status">Checking the latest available intraday price…</p>
                <p class="list-note" data-quote-time></p>
                <p class="list-note" data-quote-error role="status"></p>
                <p class="muted">Checks every minute while this page is visible and the market is open; less often when closed or unavailable. Quotes may be delayed or restricted by your data plan. The chart and research signals below use daily prices.</p>
                <noscript><p>Enable JavaScript to load and update intraday price snapshots.</p></noscript>
            </section>
        }
        @if (Model.Data is not { } data || Model.Result is not { } result)
        {
            <section class="panel setup-panel">
                @if (Model.Error is not null && Model.Symbol is not null)
                {
                    <p class="eyebrow">PRICES COULD NOT BE LOADED</p><h2>@Model.Symbol</h2>
                    <p>The price request failed. The reason is shown above. No chart or investment signal is available until valid daily prices are retrieved.</p>
                    <a class="text-link" asp-page="/Index" asp-route-Symbol="@Model.Symbol">Try loading prices again →</a>
                }
                else
                {
                    <p class="eyebrow">SELECT A COMPANY</p><h2>Choose a company to analyse.</h2>
                    <p>Select View beside a company to load its daily prices, chart and analysis.</p>
                }
                <p>Buy and Sell are research signals from disclosed rules. If reliable history is too short, the analysis reports insufficient data.</p>
            </section>
        }
        else
        {
            <section class="panel company-detail"><div class="panel-heading"><div><p class="eyebrow">@data.Symbol / @IndexModel.DisplaySource(data.Source)</p><h2 class="company-title">@data.Name</h2></div><span class="count">@(data.IsSample ? "FICTIONAL DATA" : data.IsImported ? "IMPORTED DATA" : "PUBLIC MARKET DATA")</span></div>
                @if (data.IsSample) { <aside class="notice inset"><strong>Fictional demonstration.</strong> These prices and results cannot inform a real investment.</aside> }
                <div class="quote"><strong><span>@data.Currency</span> @(data.Price?.ToString("N2") ?? "—")</strong><span class="muted">@(data.Quote is null ? "Latest stored daily close" : "Snapshot price · " + data.Quote.MarketState)</span></div>
                <p class="list-note">@(data.Quote is null ? "Daily bar time" : "Quote time"): @IndexModel.DisplayTime(data.Quote?.UpdatedAt ?? data.Daily.LastOrDefault()?.Time) · Retrieved: @IndexModel.DisplayTime(data.RetrievedAt)</p>
                @if (data.Daily.Length > 1)
                {
                    var chart = data.Daily.TakeLast(120).ToArray(); var min = chart.Min(b => b.Close); var range = Math.Max(chart.Max(b => b.Close) - min, 0.01m);
                    var change = chart[^1].Close - chart[0].Close;
                    var changePercent = change / chart[0].Close * 100m;
                    var chartColor = change > 0 ? "#079a80" : change < 0 ? "#b84a45" : "#6b7f7a";
                    var chartClass = change > 0 ? "positive" : change < 0 ? "negative" : "muted";
                    var chartDirection = change > 0 ? "Up" : change < 0 ? "Down" : "Unchanged";
                    var points = string.Join(" ", chart.Select((b,i) => $"{(i * 600m / (chart.Length - 1)).ToString("0.##", CultureInfo.InvariantCulture)},{(150m - (b.Close - min) / range * 130m).ToString("0.##", CultureInfo.InvariantCulture)}"));
                    <div class="chart-label"><span>Daily closing prices</span><span>@chart.Length bars · @data.Currency</span></div>
                    <svg class="price-chart" viewBox="0 0 600 180" role="img" aria-label="Daily closing price chart for @data.Name. @chartDirection over the displayed period."><path d="M0 40H600 M0 90H600 M0 140H600" stroke="#e8efed" fill="none" /><polyline points="@points" stroke="@chartColor" stroke-width="3" fill="none" /></svg>
                    <p class="list-note @chartClass">@chartDirection @Math.Abs(changePercent).ToString("N2")% over the displayed period · last close versus first close</p>
                    <div class="chart-label"><span>@chart[0].Time.ToString("dd MMM yyyy")</span><span>@chart[^1].Time.ToString("dd MMM yyyy")</span></div>
                }
                @if (!data.IsSample) { <div class="inset spaced favourite-detail"><button type="button" class="outline favourite-toggle" data-symbol="@data.Symbol" data-name="@data.Name" aria-pressed="false" hidden>☆ Favourite</button></div> }


            </section>
            <section class="panel analysis"><div class="panel-heading"><h2>Investment analysis</h2><span class="count">Rule-based baseline</span></div>
                <form method="get" class="analysis-controls"><input type="hidden" name="Symbol" value="@data.Symbol" /><input type="hidden" name="Demo" value="@Model.Demo.ToString().ToLowerInvariant()" />@if (Model.DailyOnly) { <span>Timeframe: Weeks / months</span><input type="hidden" name="Horizon" value="swing" /> } else { <label for="horizon">Timeframe</label><select id="horizon" asp-for="Horizon"><option value="swing">Weeks / months</option><option value="long">Long-term</option></select> }<label class="check"><input asp-for="OwnsStock" /> I own this stock</label><label for="CostBps">Backtest cost per side (bps)</label><input asp-for="CostBps" type="number" min="0" max="100" step="0.1" /><button type="submit">Analyse</button></form>
                <div class="assessment"><p class="eyebrow">@(data.IsSample ? "FICTIONAL DEMO SIGNAL" : "RESEARCH SIGNAL")</p><h3>@result.Signal</h3><p>@result.Summary</p><p class="spaced"><strong>@IndexModel.DisplaySource(result.Basis)</strong><br />@(Model.Horizon == "long" ? "Financial reporting period ended" : "Price bar timestamp used"): @IndexModel.DisplayTime(result.AsOf)</p><p class="list-note">@(Model.Horizon == "long" ? "Financial reporting date; current valuation uses a separate timestamp." : "Provider bar timestamp, which may mark the start of the daily session rather than its closing time. Quote and retrieval times are shown above.")</p></div>
                <div class="metrics">@foreach (var metric in result.Metrics) { <div><span>@metric.Name</span><strong>@metric.Value</strong></div> }</div>
                <div class="setup-panel"><h2>Why this result?</h2><ul>@foreach (var reason in result.Reasons) { <li>@reason</li> }</ul>
                    @if (result.StopReference is { } stop) { <p>ATR reference stop: <strong>@data.Currency @stop.ToString("N2")</strong> · Reference target: <strong>@data.Currency @result.TargetReference?.ToString("N2")</strong>. These levels are not used as orders in the backtest.</p> }
                    <h2>Risks and limits</h2><ul>@foreach (var risk in result.Risks) { <li>@risk</li> }</ul>
                    <a class="text-link" asp-page="/Index" asp-page-handler="Export" asp-route-Symbol="@data.Symbol" asp-route-Horizon="@Model.Horizon" asp-route-Demo="@Model.Demo" asp-route-OwnsStock="@Model.OwnsStock" asp-route-CostBps="@Model.CostBps">Download analysis JSON</a>
                </div>
            </section>
            <section class="panel setup-panel"><h2>Historical strategy check</h2>
                @if (Model.Backtest is { } bt)
                {
                    <p>@IndexModel.DisplayTime(bt.Start) to @IndexModel.DisplayTime(bt.End) · @bt.CostBps bps costs per side</p>
                    <div class="metrics"><div><span>Strategy return</span><strong>@bt.ReturnPercent.ToString("N2")%</strong></div><div><span>Buy & hold return</span><strong>@bt.BuyHoldPercent.ToString("N2")%</strong></div><div><span>Maximum drawdown</span><strong>@bt.MaxDrawdownPercent.ToString("N2")%</strong></div><div><span>Closed round trips</span><strong>@bt.ClosedTrades</strong></div><div><span>Historical trade win rate</span><strong>@(bt.WinRatePercent?.ToString("N2") ?? "N/A")@(bt.WinRatePercent is null ? "" : "%")</strong></div></div>
                    <p>Signals use the prior close, trades use the next open, and any final holding is liquidated at the last close. Long-only; Hold leaves the current position unchanged. Benchmark uses the same starting open and costs. Taxes, market impact and separate cash-dividend payments are excluded. Provider-adjusted prices may embed dividend adjustments.</p><p><strong>This is a retrospective check on one series, not an independent validation or a probability that this recommendation will succeed.</strong> @if (data.IsSample) { <span>The backtest data is fictional too.</span> }</p>
                }
                else { <p>A swing backtest needs at least 90 completed, split-adjusted daily bars. Intraday and fundamentals backtests are not implemented.</p> }
            </section>
        }
        </div>
    </div>
</div>
@section Scripts { <script src="~/js/favourites.js" asp-append-version="true" defer></script><script src="~/js/intraday-quote.js" asp-append-version="true" defer></script> }
